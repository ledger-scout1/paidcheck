# PaidCheck configuration — copy to ".env" and fill in your SANDBOX values.
# Get them at https://developer.paypal.com -> Dashboard -> My Apps & Credentials
# -> (Sandbox tab) -> Create App. These are TEST credentials: they can only
# move fake money inside the PayPal sandbox.

PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-secret
PAYPAL_ENV=sandbox

# Optional: port for the local demo UI (default 8000)
PAIDCHECK_PORT=8000

# Optional: where the local claims ledger lives (default ./data/claims.db)
# PAIDCHECK_DB=data/claims.db

# Optional LLM claim parser (OFF by default; the deterministic parser is the
# demo path and needs no key). Set to 1 and provide a key to let an LLM fill
# in fields the rules-based parser could not find.
# PAIDCHECK_LLM_PARSER=0
# OPENAI_API_KEY=
